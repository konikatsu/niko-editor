{
  "name": "niko-editor",
  "version": "1.0.0",
  "description": "色付け・検索・置換がかんたんなMarkdown・HTML・テキストエディタ",
  "scripts": {
    "start": "node scripts/server.cjs",
    "prepare-assets": "node scripts/prepare.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check dist/app.js && node --check dist/editor-core.js && node --check dist/desktop.js && node --check dist/html-document.js && node --check dist/work-app.js",
    "desktop": "tauri dev",
    "icons": "node scripts/create-icon.cjs",
    "build:win": "tauri build --bundles nsis && node scripts/collect-release.cjs",
    "build:dir": "tauri build --no-bundle"
  },
  "keywords": [],
  "author": "NIKO Editor contributors",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.12.4",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "marked": "18.1.2",
    "parse5": "8.1.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
