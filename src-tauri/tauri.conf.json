{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIKO Editor",
  "version": "1.0.0",
  "identifier": "jp.niko.editor",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run prepare-assets && npm run icons",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "色付けも検索もかんたんなテキストエディタ",
    "copyright": "Copyright © 2026 NIKO Editor contributors",
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Japanese"],
        "installMode": "currentUser"
      }
    }
  }
}
